{
  "version": "1.0",
  "_comment": ["OIDC client for local development only: dbal runs with profile local-sso."],
  "clients": [
    {
      "client_id": "businessplanner-app",
      "client_name": "LaunchPad (local)",
      "token_endpoint_auth_method": "none",
      "grant_types": ["authorization_code", "refresh_token"],
      "response_types": ["code"],
      "redirect_uris": ["http://localhost:8892/app/en/auth/callback"],
      "post_logout_redirect_uris": ["http://localhost:8892/app/en/login"],
      "require_pkce": true,
      "pkce_methods": ["S256"],
      "scope": "openid profile email offline_access",
      "access_token_ttl_seconds": 900,
      "refresh_token_ttl_seconds": 1209600,
      "id_token_ttl_seconds": 900
    }
  ]
}
