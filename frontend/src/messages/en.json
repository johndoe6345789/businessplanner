  "planner": {
    "pageTitle": "Your Startup Roadmap",
    "pageSubtitle": "Six phases from idea to launch. Check each step as you go.",
    "overallProgress": "Overall progress",
    "stepsOf": "{done} of {total} steps done",
    "askAdvisor": "Ask AI Advisor",
    "reset": "Reset progress",
    "resetConfirm": "Reset all progress? This cannot be undone.",
    "hideDetail": "▲ hide detail",
    "whyThisMatters": "▼ why this matters",
    "phases": {
      "validate": {
        "title": "Validate Your Idea",
        "desc": "Confirm the problem is real before you build anything."
      },
      "plan": {
        "title": "Build Your Plan",
        "desc": "Turn your idea into a clear, fundable business model."
      },
      "legal": {
        "title": "Legal & Structure",
        "desc": "Set up the right legal foundation from day one."
      },
      "finance": {
        "title": "Fund & Finance",
        "desc": "Know your numbers, plan your runway."
      },
      "build": {
        "title": "Build Your Product",
        "desc": "Ship an MVP that solves the core problem."
      },
      "launch": {
        "title": "Launch & Grow",
        "desc": "Acquire your first customers and build momentum."
      }
    },
    "steps": {
      "defineProblem": {
        "title": "Define the problem you are solving",
        "why": "Write one sentence: who has this problem, what it costs them, and why existing solutions fall short. Clarity here shapes every decision that follows."
      },
      "interviewCustomers": {
        "title": "Talk to 10 potential customers",
        "why": "Structured discovery interviews — not demos. Ask how they solve the problem today, what they pay, and what they wish existed. Never mention your solution until they describe the pain themselves."
      },
      "mapCompetitors": {
        "title": "Map the competitive landscape",
        "why": "List every direct and indirect alternative. Note their pricing, weaknesses, and ideal customer. Your positioning lives in the gaps you find here."
      },
      "landingPageTest": {
        "title": "Run a landing page test",
        "why": "Build a simple page explaining your solution. Drive traffic with small paid ads or posts. Measure email sign-up rate — 5%+ means real interest. Ship nothing until this passes."
      },
      "onePagePlan": {
        "title": "Write a one-page business plan",
        "why": "Cover: problem, solution, market size, revenue model, and your unfair advantage. One page forces clarity. If you cannot explain it simply, you do not understand it yet."
      },
      "revenueModel": {
        "title": "Choose your revenue model",
        "why": "Subscription, one-time fee, marketplace take-rate, or services. Each model changes your sales cycle and funding needs. Commit to one for the MVP."
      },
      "idealCustomer": {
        "title": "Define your Ideal Customer Profile",
        "why": "Industry, company size, job title, pain level, and budget. The narrower your ICP, the cheaper and easier acquisition becomes. You can broaden later."
      },
      "financialProjections": {
        "title": "Build 12-month financial projections",
        "why": "Model revenue, costs, and burn. The numbers will be wrong — that is fine. The exercise reveals hidden assumptions and shows when you run out of cash."
      },
      "chooseStructure": {
        "title": "Choose a business structure",
        "why": "LLC is simplest for most solo founders. C-Corp (Delaware) is required for VC funding. Consult a startup lawyer — the choice has long-term tax and ownership implications."
      },
      "registerCompany": {
        "title": "Register your company",
        "why": "File with your state (US) or Companies House (UK). Delaware C-Corp is the VC standard. Services like Stripe Atlas or Clerky make it fast and affordable."
      },
      "taxId": {
        "title": "Obtain your EIN or tax ID",
        "why": "An EIN is required to open a business bank account, pay contractors, and file taxes. Apply free at irs.gov — takes about 15 minutes online."
      },
      "businessBankAccount": {
        "title": "Open a dedicated business bank account",
        "why": "Mixing personal and business money is a legal and accounting disaster. Open Mercury, Relay, or a local business account the day you register."
      },
      "protectIp": {
        "title": "Protect your intellectual property",
        "why": "File a trademark for your brand name and logo. For novel tech, file a provisional patent to lock your priority date. Have all contractors sign IP assignment agreements."
      },
      "bootstrapOrRaise": {
        "title": "Decide: bootstrap or raise funding?",
        "why": "Bootstrapping keeps full control but limits speed. Raising capital accelerates growth but dilutes ownership and adds investor obligations. Align with your market's pace."
      },
      "setupAccounting": {
        "title": "Set up accounting software",
        "why": "Use QuickBooks, Xero, or Wave from day one. Track every transaction. Clean books are essential for tax time, investor due diligence, and knowing your real margins."
      },
      "calculateRunway": {
        "title": "Calculate your runway",
        "why": "Monthly burn ÷ cash in bank = months until zero. You should always have at least 12 months visible or a funded plan to get there. This number drives every hiring decision."
      },
      "pathToRevenue": {
        "title": "Map the path to your first dollar",
        "why": "Identify exactly: who pays, how much, when, and why now. Walk every step from a stranger discovering you to money in your account. Remove every unnecessary step."
      },
      "mvpScope": {
        "title": "Define your MVP scope",
        "why": "List every feature you think you need. Cut 80% of it. An MVP solves exactly one problem for one user type — nothing more. The goal is learning, not completeness."
      },
      "buildOrContract": {
        "title": "Build in-house or contract out?",
        "why": "Technical founders should build. Non-technical founders: hire a contractor for the MVP, then bring on a technical co-founder or CTO before raising a seed round."
      },
      "toolStack": {
        "title": "Set up your core tool stack",
        "why": "You need: communication (Slack), project management (Linear or Notion), version control (GitHub), analytics (Mixpanel), and payments (Stripe). Start lean."
      },
      "firstHire": {
