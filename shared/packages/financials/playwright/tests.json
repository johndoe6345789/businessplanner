{
  "$schema": "https://metabuilder.dev/schemas/package-playwright.schema.json",
  "package": "financials",
  "description": "Burn rate calculator page tests",
  "tests": [
    {
      "name": "burn rate page loads with heading",
      "tags": ["@smoke", "@financials"],
      "steps": [
        {
          "action": "navigate",
          "url": "/financials/burn"
        },
        {
          "action": "waitForLoadState",
          "state": "domcontentloaded"
        },
        {
          "action": "expect",
          "role": "heading",
          "assertion": { "matcher": "toBeVisible" }
        }
      ]
    },
    {
      "name": "burn input fields visible",
      "tags": ["@financials"],
      "steps": [
        {
          "action": "navigate",
          "url": "/financials/burn"
        },
        {
          "action": "waitForLoadState",
          "state": "domcontentloaded"
        },
        {
          "action": "expect",
          "testId": "burn-rate-calculator",
          "assertion": { "matcher": "toBeVisible" }
        },
        {
          "action": "expect",
          "testId": "burn-input-fields",
          "assertion": { "matcher": "toBeVisible" }
        }
      ]
    },
    {
      "name": "fill monthly burn shows runway display",
      "tags": ["@financials"],
      "steps": [
        {
          "action": "navigate",
          "url": "/financials/burn"
        },
        {
          "action": "waitForLoadState",
          "state": "domcontentloaded"
        },
        {
          "action": "fill",
          "label": "Monthly Burn (£)",
          "value": "5000"
        },
        {
          "action": "expect",
          "testId": "burn-result-display",
          "assertion": { "matcher": "toBeVisible" }
        }
      ]
    },
    {
      "name": "health page loads with scorecard",
      "tags": ["@smoke", "@financials"],
      "steps": [
        {
          "action": "navigate",
          "url": "/financials/health"
        },
        {
          "action": "waitForLoadState",
          "state": "domcontentloaded"
        },
        {
          "action": "expect",
          "testId": "financials-health-page",
          "assertion": { "matcher": "toBeVisible" }
        }
      ]
    },
    {
      "name": "financials dashboard page loads",
      "tags": ["@smoke", "@financials"],
      "steps": [
        {
          "action": "navigate",
          "url": "/financials/dashboard"
        },
        {
          "action": "waitForLoadState",
          "state": "domcontentloaded"
        },
        {
          "action": "expect",
          "testId": "financials-dashboard-page",
          "assertion": { "matcher": "toBeVisible" }
        }
      ]
    }
  ]
}
