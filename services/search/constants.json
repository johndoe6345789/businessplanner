{
  "esHost": "elasticsearch",
  "esPort": 9200,
  "batchSize": 500,
  "reindexIntervalSeconds": 3600,
  "kafkaTopic": "search.reindex",
  "kafkaGroup": "search-indexer",
  "httpPort": 8086,
  "indexes": [
    {
      "name": "kb_content",
      "targetTable": "kb_content",
      "esIndex": "launchpad-kb",
      "fields": ["id", "content_type",
                 "startup_type", "stage",
                 "title", "body_md",
                 "tags", "updated_at"],
      "idField": "id"
    },
    {
      "name": "planner_steps",
      "targetTable": "planner_steps",
      "esIndex": "launchpad-planner",
      "fields": ["id", "step_id",
                 "startup_type", "stage",
                 "title", "description", "tags"],
      "idField": "id"
    },
    {
      "name": "community_posts",
      "targetTable": "comments_v2",
      "esIndex": "launchpad-community",
      "fields": ["id", "target_type", "target_id",
                 "author_id", "startup_type",
                 "title", "body", "created_at"],
      "idField": "id"
    },
    {
      "name": "founders",
      "targetTable": "users",
      "esIndex": "launchpad-founders",
      "fields": ["id", "username", "display_name",
                 "startup_type", "stage", "bio"],
      "idField": "id"
    }
  ]
}
