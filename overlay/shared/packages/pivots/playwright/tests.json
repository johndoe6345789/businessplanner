{
  "$schema": "https://metabuilder.dev/schemas/package-playwright.schema.json",
  "package": "pivots",
  "description": "Pivot tracker page smoke tests",
  "tests": [
    {
      "name": "pivots page loads",
      "tags": ["@smoke", "@pivots"],
      "steps": [
        {
          "action": "navigate",
          "url": "/pivots"
        },
        {
          "action": "waitForLoadState",
          "state": "domcontentloaded"
        },
        {
          "action": "expect",
          "testId": "pivots-page",
          "assertion": { "matcher": "toBeVisible" }
        }
      ]
    },
    {
      "name": "pivot tracker component renders",
      "tags": ["@pivots"],
      "steps": [
        {
          "action": "navigate",
          "url": "/pivots"
        },
        {
          "action": "waitForLoadState",
          "state": "domcontentloaded"
        },
        {
          "action": "expect",
          "testId": "pivot-tracker",
          "assertion": { "matcher": "toBeVisible" }
        }
      ]
    },
    {
      "name": "add pivot button is visible",
      "tags": ["@pivots"],
      "steps": [
        {
          "action": "navigate",
          "url": "/pivots"
        },
        {
          "action": "waitForLoadState",
          "state": "domcontentloaded"
        },
        {
          "action": "expect",
          "testId": "pivot-add-btn",
          "assertion": { "matcher": "toBeVisible" }
        }
      ]
    }
  ]
}
